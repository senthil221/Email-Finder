# Copy to .env next to docker-compose.yml on the server.

# Public address of the app (Traefik routes it and gets the HTTPS certificate)
APP_HOST=emailfinder.srv1826728.hstgr.cloud

# Login for the web app (HTTP Basic auth)
APP_USER=admin
APP_PASSWORD=change-me

# Database password (any long random string)
POSTGRES_PASSWORD=change-me-too

# MailTester Ninja
MTN_API_KEY=
# Pace measured by Prospect Sync on the Ultimate plan (documented 23 per 10s;
# 25 per 10s got HTTP 429 within minutes). If this key is SHARED with another
# app, split these numbers between the apps.
MTN_RATE_MAX=22            # starts per window
MTN_RATE_WINDOW_MS=10000
MTN_MIN_SPACING_MS=450     # at least this long between starts
MTN_DAILY_LIMIT=190000     # per rolling 24 hours, retries included (plan: 200,000)
MTN_TIMEOUT_MS=45000

# Worker
SCOUT_MAX_PATTERNS=6      # base patterns tried per person (0 = all 9); your top patterns go first
LADDER_MIN_FINDS=300       # finds needed before your own data decides the try order
WORKER_CONCURRENCY=12      # companies processed in parallel
RETRY_DELAY_MS=20000       # wait before retrying a Timeout / SPAM Block

# Local development only (npm run dev:db / dev:mtn):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
# MTN_BASE_URL=http://127.0.0.1:4010/ninja
